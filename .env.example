# Copy to .env; docker compose reads it automatically. Every value is optional.

# --- AI ---------------------------------------------------------------------------
# Not used until phase 4 (the copilot); the AI service starts without it.
ANTHROPIC_API_KEY=

# --- Host ports (defaults shown) ----------------------------------------------------
# Postgres defaults to 5433 so it never collides with a local Postgres on 5432.
# WEB_PORT=3000
# GATEWAY_PORT=8080
# POSTGRES_PORT=5433
# REDIS_PORT=6379
# S3_PORT=9000
# S3_CONSOLE_PORT=9001
# OIDC_DEV_PORT=8090

# --- Public URLs --------------------------------------------------------------------
# Change both when serving the stack under other hostnames. The web image must be
# rebuilt after changing PUBLIC_GATEWAY_URL (it is inlined into the client bundle).
# PUBLIC_GATEWAY_URL=http://localhost:8080
# PUBLIC_WEB_URL=http://localhost:3000
# COOKIE_SECURE=false        # must be true anywhere served over https

# --- Demo data ------------------------------------------------------------------------
# SEED_DEMO=true             # demo@lattice.dev / lattice-demo

# --- Single sign-on (OpenID Connect) --------------------------------------------------
# List the providers to enable; each needs ISSUER and CLIENT_ID (and usually CLIENT_SECRET).
# Redirect URI to register with the provider: ${PUBLIC_GATEWAY_URL}/api/auth/oidc/<id>/callback
# OIDC_PROVIDERS=google,microsoft
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=

# Try SSO locally with the bundled dev identity provider (any username works):
#   docker compose --profile sso up
# OIDC_PROVIDERS=sso
# OIDC_SSO_ISSUER=http://localhost:8090/default
# OIDC_SSO_CLIENT_ID=lattice-dev
# OIDC_SSO_CLIENT_SECRET=dev-secret

# --- Observability ----------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
# RUST_LOG=info,lattice_api=debug
