expression: "render(json!({\n    \"dimensions\": [{ \"column\": \"category\" }], \"measures\":\n    [{ \"column\": \"amount\", \"agg\": \"sum\" }], \"sort\":\n    [{ \"by\": \"sum_amount\", \"dir\": \"desc\" }], \"limit\": 10\n}))"
