SELECT sum("e0"."amount") FILTER (WHERE ("e0"."status" = ?)) AS "net_revenue" FROM "project"."s"."orders" AS "e0" LEFT JOIN "project"."s"."customers" AS "e1" ON "e0"."customer_id" = "e1"."customer_id" WHERE "e0"."region" IN (?) AND "e1"."segment" = ? AND "e0"."order_date" BETWEEN CAST(? AS DATE) AND CAST(? AS DATE) AND COALESCE("e1"."is_internal" = ?, TRUE) ORDER BY "net_revenue" DESC NULLS LAST LIMIT 10001
